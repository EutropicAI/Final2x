{
  "name": "Final2x",
  "productName": "Final2x",
  "version": "4.1.0-dev",
  "packageManager": "pnpm@10.17.1",
  "description": "A cross-platform image super-resolution tool.",
  "author": "Tohrusky",
  "homepage": "https://github.com/EutropicAI/Final2x",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "test": "vitest run --coverage",
    "lint": "pnpm run lint:frontend && pnpm run lint:core",
    "lint:fix": "pnpm run lint:frontend:fix && pnpm run lint:core:fix",
    "lint:frontend": "eslint .",
    "lint:frontend:fix": "eslint . --fix",
    "lint:core": "uv run --project core --no-sync pre-commit run --all-files --config core/.pre-commit-config.yaml",
    "lint:core:fix": "uv run --project core ruff check core --fix && uv run --project core ruff format core && uv run --project core mypy --config-file core/pyproject.toml core/Final2x_core core/tests",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "version:check": "python scripts/check_version.py",
    "core:sync": "uv sync --project core --locked",
    "core:sync:bundle": "uv sync --project core --locked --no-default-groups --group dev",
    "core:config": "uv run --project core python core/scripts/gen_config.py",
    "core:generate": "uv run --project core python core/scripts/gen_pretrained_model_name.py --output src/renderer/src/utils/modelOptions.ts",
    "core:generate:check": "pnpm run core:generate && git diff --exit-code -- src/renderer/src/utils/modelOptions.ts",
    "core:test:unit": "uv run --project core pytest core/tests --cov=Final2x_core --cov-report=xml:core/coverage.xml --cov-report=html:core/htmlcov",
    "core:test": "pnpm run core:config && pnpm run core:test:unit",
    "core:check": "pnpm run core:config && pnpm run core:generate:check && pnpm run lint:core && pnpm run core:test:unit",
    "core:build": "uv build core",
    "core:build:wheel": "uv build --wheel core",
    "core:bundle": "uv run --project core --no-sync python core/scripts/gen_config.py && uv run --project core --no-sync pyinstaller --noconfirm --name Final2x-core --icon core/assets/favicon.ico --distpath core/dist --workpath core/build core/Final2x_core/__main__.py && uv run --project core --no-sync python core/scripts/post_pyinstaller.py",
    "core:test:bundle:windows": "cd core\\dist\\Final2x-core && .\\Final2x-core",
    "core:test:bundle:unix": "cd core/dist/Final2x-core && ./Final2x-core",
    "core:test:pip": "python core/scripts/gen_config.py && python core/scripts/CItestpip.py",
    "build:mac-arm64": "pnpm run build && electron-builder --mac --arm64 --publish=never",
    "build:mac-x64": "pnpm run build && electron-builder --mac --x64 --publish=never",
    "build:win-arm64": "pnpm run build && electron-builder --win --arm64 --dir --publish=never",
    "build:win-x64": "pnpm run build && electron-builder --win --x64 --dir --publish=never",
    "build:linux-x64": "pnpm run build && electron-builder --linux --x64 --publish=never",
    "build:linux-arm64": "pnpm run build && electron-builder --linux --arm64 --publish=never"
  },
  "dependencies": {
    "@intlify/unplugin-vue-i18n": "^6.0.8",
    "@vicons/antd": "^0.13.0",
    "@vicons/ionicons5": "^0.13.0",
    "naive-ui": "^2.43.1",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.5.0",
    "sass": "^1.93.2",
    "systeminformation": "^5.30.8",
    "tree-kill": "^1.2.2",
    "vfonts": "^0.0.3",
    "vue": "^3.5.22",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.4.1",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/notarize": "^2.5.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "electron": "^27.3.11",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "eslint": "^9.37.0",
    "extract-zip": "^2.0.1",
    "jsdom": "^26.1.0",
    "node-fetch": "^3.3.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.11",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.6",
    "vue-tsc": "^3.1.0"
  }
}
